{
  "name": "@medyll/idae-machine",
  "description": "SvelteKit based framework to build AI powered applications with ease.",
  "bin": {
    "idae-machine": "./cli.cjs"
  },
  "version": "0.136.10",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "lint:arch": "eslint --config eslint.arch.config.js src",
    "conventions": "node scripts/scan-conventions.mjs",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:e2e": "playwright test --config src/e2e/playwright.config.ts",
    "gate": "npm run lint:arch && npm run check && npm run test && npm --prefix server run typecheck && npm --prefix server run test",
    "prepackage": "node scripts/package-pre.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "author": "Lebrun Meddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medyll/idae.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@medyll/idae-eslint-config": "workspace:*",
    "@medyll/idae-router": "workspace:*",
    "@medyll/idae-shared": "workspace:*",
    "@medyll/idae-socket": "workspace:*",
    "@medyll/qoolie": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@semantic-release/github": "^12.0.10",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "mongodb": "~7.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "scope": "medyll",
  "keywords": [
    "idae",
    "machine",
    "framework",
    "sveltekit",
    "ai",
    "application"
  ],
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify/svelte": "^5.2.2",
    "@medyll/css-base": "link:..\\..\\..\\css-base",
    "@medyll/idae-api": "workspace:*",
    "@medyll/idae-be": "workspace:*",
    "@medyll/idae-idbql": "workspace:*",
    "@medyll/qoolie": "workspace:*",
    "command": "^1.1.1",
    "commander": "^15.0.0"
  }
}
