{
  "name": "@medyll/idae-machine-server",
  "version": "2.0.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "idae-machine v2 server - API and sync layer",
  "type": "module",
  "main": "./dist/server/src/index.js",
  "types": "./dist/server/src/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "// package": "Workspace deps (idae-api, qoolie, idae-socket, idae-db) only resolve once their dist/ exists. On CI they are not necessarily part of the release set, so nothing builds them first and tsc fails with TS2307. Build them explicitly first.",
    "package": "pnpm --filter \"@medyll/idae-machine-server^...\" run --if-present package && tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "seed": "tsx src/bootstrap/bootstrap.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@medyll/css-base": "link:..\\..\\..\\..\\css-base",
    "@medyll/idae-api": "workspace:*",
    "@medyll/idae-socket": "workspace:*",
    "@medyll/qoolie": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.14",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^8.0.11",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@medyll/idae-db": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
