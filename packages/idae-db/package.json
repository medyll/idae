{
  "name": "@medyll/idae-db",
  "bin": {
    "idae-db": "./cli.js",
    "add-skill": "./dist/cli/add-skill.js"
  },
  "version": "0.155.3",
  "author": "Lebrun Meddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medyll/idae.git"
  },
  "description": "@medyll/idae-db is a flexible and powerful library for interacting with various databases, with a particular focus on MongoDB support. It offers robust connection management, an intuitive API, and simplified CRUD operations.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mongodb": "vitest run tests/mongodb.test.ts",
    "test:watch": "vitest --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepackage": "node scripts/package-pre.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "pg": ">=8.0.0",
    "pouchdb": ">=8.0.0",
    "sqlite3": ">=5.1.0",
    "svelte": "^5.0.0-next"
  },
  "publishConfig": {
    "access": "public",
    "directory": "."
  },
  "devDependencies": {
    "@medyll/idae-eslint-config": "workspace:*",
    "@medyll/idae-query": "workspace:*",
    "@medyll/idae-shared": "workspace:*",
    "@semantic-release/github": "^12.0.9",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/eslint": "^9.6.1",
    "@types/pouchdb": "^6.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "mongodb-memory-server": "^11.2.0",
    "pg": "^8.22.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.22",
    "sqlite3": "^6.0.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "idae",
    "db",
    "database",
    "mongo",
    "mysql",
    "sqlite",
    "pouchdb",
    "orm"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scope": "medyll",
  "dependencies": {
    "@medyll/skiller": "workspace:*",
    "chromadb": "^3.5.0",
    "command": "^1.1.1",
    "commander": "^15.0.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.2"
  }
}
