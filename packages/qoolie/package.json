{
  "name": "@medyll/qoolie",
  "version": "0.0.9",
  "description": "Client database IndexedDB the easy way, add server sync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "bin": {
    "qoolie": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/adapters/svelte/index.d.ts",
      "svelte": "./dist/adapters/svelte/index.js",
      "default": "./dist/adapters/svelte/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "// package": "The release tool runs 'package' before publishing and skips packages that lack it — which is why 0.0.2 shipped with no dist/ and an unresolvable main.",
    "package": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "check": "tsc --noEmit",
    "bench": "tsx benchmarks/index.ts",
    "prepackage": "node scripts/package-pre.js"
  },
  "dependencies": {
    "@medyll/idae-sync": "workspace:*",
    "@medyll/skiller": "workspace:*",
    "commander": "^15.0.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@medyll/idae-socket": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.3.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@medyll/idae-socket": "workspace:*",
    "react": ">=18.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@medyll/idae-socket": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "indexeddb",
    "sync",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Lebrun Meddy",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medyll/idae.git"
  },
  "publishConfig": {
    "access": "public",
    "directory": "."
  },
  "scope": "medyll"
}
